rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: clients can create orders and read their own/tables; kitchen/staff can read/update all
    match /orders/{orderId} {
      allow read, write: if true;
    }
    // Table calls collection: service calls (addition, couverts, boisson, etc.)
    match /calls/{callId} {
      allow read, write: if true;
    }
    // General tables status/config
    match /tables/{tableId} {
      allow read, write: if true;
    }
  }
}
